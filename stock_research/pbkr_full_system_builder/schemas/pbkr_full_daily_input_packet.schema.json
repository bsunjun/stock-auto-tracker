{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pbkr.local/v1/full-system/pbkr_full_daily_input_packet.schema.json",
  "title": "PBKR Full System v1 — Full DAILY_INPUT_PACKET",
  "description": "Aggregator that wraps the full handbook funnel into one packet for the GPT Orchestrator: market breadth, KR leader universe, sector + theme leadership, specialist screens (existing v4 screening_candidates_pack), and evidence overlay. screening_only=true; candidate_generation_only=true; direct_trade_signal=false; automatic_execution_allowed=false; trade_ticket_generation_allowed=false; human_gate_required=true; operator_decision must be null|review|defer (never execute).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asof",
    "pbkr_rs_rank_source",
    "tradingview_role",
    "market_breadth_summary",
    "kr_leader_universe_summary",
    "sector_leadership_summary",
    "theme_leadership_summary",
    "specialist_screen_summary",
    "evidence_overlay_summary",
    "signal_safety"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^v1\\.[0-9]+(\\.[0-9]+)?$" },
    "asof": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([+-][0-9]{2}:[0-9]{2}|Z)$" },
    "pbkr_rs_rank_source": { "const": "kiwoom_daily_universe" },
    "tradingview_role": { "const": "auxiliary" },
    "market_breadth_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regime", "pct_above_ma200", "advance_decline_ratio"],
      "properties": {
        "regime": { "enum": ["unknown", "stage1", "stage2", "stage3", "stage4"] },
        "pct_above_ma50": { "type": "number", "minimum": 0, "maximum": 100 },
        "pct_above_ma200": { "type": "number", "minimum": 0, "maximum": 100 },
        "advance_decline_ratio": { "type": "number", "minimum": 0 }
      }
    },
    "kr_leader_universe_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["universe_size", "leader_count", "rs_threshold"],
      "properties": {
        "universe_size": { "type": "integer", "minimum": 0 },
        "leader_count": { "type": "integer", "minimum": 0 },
        "rs_threshold": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "sector_leadership_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sector_count", "leading_count"],
      "properties": {
        "sector_count": { "type": "integer", "minimum": 0 },
        "leading_count": { "type": "integer", "minimum": 0 },
        "lagging_count": { "type": "integer", "minimum": 0 },
        "top_leading": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sector_id", "sector_name", "median_rank"],
            "properties": {
              "sector_id": { "type": "string", "maxLength": 32 },
              "sector_name": { "type": "string", "maxLength": 64 },
              "median_rank": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          }
        }
      }
    },
    "theme_leadership_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme_count", "leading_count"],
      "properties": {
        "theme_count": { "type": "integer", "minimum": 0 },
        "leading_count": { "type": "integer", "minimum": 0 },
        "lagging_count": { "type": "integer", "minimum": 0 },
        "top_leading": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["theme_id", "theme_name", "median_rank"],
            "properties": {
              "theme_id": { "type": "string", "maxLength": 32 },
              "theme_name": { "type": "string", "maxLength": 64 },
              "median_rank": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          }
        }
      }
    },
    "specialist_screen_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "by_state", "by_screen"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "by_state": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "by_screen": {
          "type": "object",
          "additionalProperties": false,
          "required": ["first_pullback", "pre_breakout_watch", "hve_gap_watch"],
          "properties": {
            "first_pullback": { "type": "integer", "minimum": 0 },
            "pre_breakout_watch": { "type": "integer", "minimum": 0 },
            "hve_gap_watch": { "type": "integer", "minimum": 0 }
          }
        },
        "watch_candidate_top": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ticker", "name", "pbkr_rs_rank", "state", "screen"],
            "properties": {
              "ticker": { "type": "string", "maxLength": 32 },
              "name": { "type": "string", "maxLength": 64 },
              "pbkr_rs_rank": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
              "state": {
                "enum": [
                  "WATCH_CANDIDATE",
                  "WATCH_ONLY",
                  "RISK_FLAG_PULLBACK_WATCH",
                  "REGULAR_PB_EXCLUDE",
                  "SCREENING_EXCLUDE"
                ]
              },
              "screen": {
                "enum": ["first_pullback", "pre_breakout_watch", "hve_gap_watch", "none"]
              }
            }
          }
        }
      }
    },
    "evidence_overlay_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "telegram_row_count",
        "report_row_count",
        "news_row_count",
        "official_risk_row_count"
      ],
      "properties": {
        "telegram_row_count": { "type": "integer", "minimum": 0 },
        "report_row_count": { "type": "integer", "minimum": 0 },
        "news_row_count": { "type": "integer", "minimum": 0 },
        "official_risk_row_count": { "type": "integer", "minimum": 0 },
        "official_risk_by_bucket": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "signal_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screening_only",
        "candidate_generation_only",
        "direct_trade_signal",
        "trade_signal",
        "automatic_execution_allowed",
        "trade_ticket_generation_allowed",
        "human_gate_required",
        "operator_decision"
      ],
      "properties": {
        "screening_only": { "const": true },
        "candidate_generation_only": { "const": true },
        "direct_trade_signal": { "const": false },
        "trade_signal": { "enum": [null, false] },
        "automatic_execution_allowed": { "const": false },
        "trade_ticket_generation_allowed": { "const": false },
        "human_gate_required": { "const": true },
        "operator_decision": { "enum": [null, "review", "defer"] }
      }
    }
  }
}
