{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pbkr.local/v1/full-system/sector_leadership_pack.schema.json",
  "title": "PBKR Full System v1 — Sector Leadership Pack",
  "description": "Funnel stage 3a. Sector-level leadership ranks derived from the KR leader universe. screening_only=true; candidate_generation_only=true.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asof",
    "pbkr_rs_rank_source",
    "sectors",
    "summary",
    "signal_safety"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^v1\\.[0-9]+(\\.[0-9]+)?$" },
    "asof": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([+-][0-9]{2}:[0-9]{2}|Z)$" },
    "pbkr_rs_rank_source": { "const": "kiwoom_daily_universe" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sector_count", "leading_count", "lagging_count"],
      "properties": {
        "sector_count": { "type": "integer", "minimum": 0 },
        "leading_count": { "type": "integer", "minimum": 0 },
        "lagging_count": { "type": "integer", "minimum": 0 }
      }
    },
    "sectors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sector_id", "sector_name", "leader_count", "median_rank", "sector_state"],
        "properties": {
          "sector_id": { "type": "string", "minLength": 1, "maxLength": 32 },
          "sector_name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "leader_count": { "type": "integer", "minimum": 0 },
          "median_rank": { "type": "number", "minimum": 0, "maximum": 100 },
          "sector_state": {
            "enum": ["leading", "lagging", "mixed", "unknown"]
          }
        }
      }
    },
    "signal_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screening_only",
        "candidate_generation_only",
        "direct_trade_signal",
        "trade_signal",
        "automatic_execution_allowed",
        "trade_ticket_generation_allowed",
        "human_gate_required"
      ],
      "properties": {
        "screening_only": { "const": true },
        "candidate_generation_only": { "const": true },
        "direct_trade_signal": { "const": false },
        "trade_signal": { "enum": [null, false] },
        "automatic_execution_allowed": { "const": false },
        "trade_ticket_generation_allowed": { "const": false },
        "human_gate_required": { "const": true }
      }
    }
  }
}
