{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pbkr.local/v1/full-system/kr_leader_universe_pack.schema.json",
  "title": "PBKR Full System v1 — KR Leader Universe Pack",
  "description": "Funnel stage 2. Filtered KR leader universe. Hard filter is pbkr_rs_rank >= 80 (sourced from Kiwoom daily-OHLCV universe). TradingView is auxiliary only. screening_only=true; candidate_generation_only=true.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asof",
    "pbkr_rs_rank_source",
    "tradingview_role",
    "rs_threshold",
    "leaders",
    "summary",
    "signal_safety"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^v1\\.[0-9]+(\\.[0-9]+)?$" },
    "asof": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([+-][0-9]{2}:[0-9]{2}|Z)$" },
    "pbkr_rs_rank_source": { "const": "kiwoom_daily_universe" },
    "tradingview_role": { "const": "auxiliary" },
    "rs_threshold": { "type": "number", "minimum": 0, "maximum": 100 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["universe_size", "leader_count"],
      "properties": {
        "universe_size": { "type": "integer", "minimum": 0 },
        "leader_count": { "type": "integer", "minimum": 0 }
      }
    },
    "leaders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticker", "name", "pbkr_rs_rank"],
        "properties": {
          "ticker": { "type": "string", "minLength": 1, "maxLength": 32 },
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "pbkr_rs_rank": { "type": "number", "minimum": 0, "maximum": 100 },
          "sector_id": { "type": "string", "maxLength": 32 },
          "theme_ids": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string", "maxLength": 32 }
          },
          "trading_value": { "type": "number", "minimum": 0 }
        }
      }
    },
    "signal_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screening_only",
        "candidate_generation_only",
        "direct_trade_signal",
        "trade_signal",
        "automatic_execution_allowed",
        "trade_ticket_generation_allowed",
        "human_gate_required"
      ],
      "properties": {
        "screening_only": { "const": true },
        "candidate_generation_only": { "const": true },
        "direct_trade_signal": { "const": false },
        "trade_signal": { "enum": [null, false] },
        "automatic_execution_allowed": { "const": false },
        "trade_ticket_generation_allowed": { "const": false },
        "human_gate_required": { "const": true }
      }
    }
  }
}
