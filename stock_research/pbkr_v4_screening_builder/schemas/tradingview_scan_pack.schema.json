{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pbkr.local/v4/screening/tradingview_scan_pack.schema.json",
  "title": "PBKR v4 — TradingView Scan Pack",
  "description": "Normalized TradingView MCP scan rows. Educational. screening_only=true.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "asof", "rows", "signal_safety"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^v4\\.[0-9]+(\\.[0-9]+)?$" },
    "asof": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([+-][0-9]{2}:[0-9]{2}|Z)$" },
    "source": { "type": "string", "maxLength": 120 },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticker", "name", "ema_state"],
        "properties": {
          "ticker": { "type": "string", "minLength": 1, "maxLength": 32 },
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "target_ema": { "type": ["integer", "null"], "minimum": 1, "maximum": 400 },
          "ema_state": { "type": "string", "enum": ["above_21ema", "at_21ema", "below_21ema", "alignment_up", "alignment_down", "mixed"] },
          "price_action_label": { "type": "string", "maxLength": 64 },
          "pullback_label": { "type": "string", "maxLength": 64 },
          "rs_proxy": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
        }
      }
    },
    "signal_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screening_only", "direct_trade_signal", "trade_signal", "automatic_execution_allowed", "human_gate_required"],
      "properties": {
        "screening_only": { "const": true },
        "direct_trade_signal": { "const": false },
        "trade_signal": { "enum": [null, false] },
        "automatic_execution_allowed": { "const": false },
        "human_gate_required": { "const": true }
      }
    }
  }
}
