{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pbkr.local/v4/screening/tradingview_scan_pack.schema.json",
  "title": "PBKR v4 — TradingView Scan Pack (auxiliary)",
  "description": "Normalized TradingView MCP scan rows. AUXILIARY only: the screening builder never uses TradingView RS_SCORE / RS_PROXY as a hard filter, and the relative-strength primary feature is computed locally as PBKR_RS_RANK from the Kiwoom daily-OHLCV universe. screening_only=true, candidate_generation_only=true.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "asof", "auxiliary_only", "rows", "signal_safety"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^v4\\.[0-9]+(\\.[0-9]+)?$" },
    "asof": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([+-][0-9]{2}:[0-9]{2}|Z)$" },
    "source": { "type": "string", "maxLength": 120 },
    "auxiliary_only": { "const": true },
    "screening_input_only": { "const": true },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticker", "name", "tv_ema_state", "tv_rs_proxy_label"],
        "properties": {
          "ticker": { "type": "string", "minLength": 1, "maxLength": 32 },
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "target_ema": { "type": ["integer", "null"], "minimum": 1, "maximum": 400 },
          "tv_ema_state": { "type": "string", "enum": ["above_21ema", "at_21ema", "below_21ema", "alignment_up", "alignment_down", "mixed"] },
          "tv_price_action_label": { "type": "string", "maxLength": 64 },
          "tv_pullback_state": { "type": "string", "maxLength": 64 },
          "tv_rs_proxy_label": { "type": "string", "enum": ["high", "mid", "low", "absent"] },
          "tv_source_timestamp": {
            "type": ["string", "null"],
            "maxLength": 40
          }
        }
      }
    },
    "signal_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screening_only",
        "candidate_generation_only",
        "direct_trade_signal",
        "trade_signal",
        "automatic_execution_allowed",
        "trade_ticket_generation_allowed",
        "human_gate_required"
      ],
      "properties": {
        "screening_only": { "const": true },
        "candidate_generation_only": { "const": true },
        "direct_trade_signal": { "const": false },
        "trade_signal": { "enum": [null, false] },
        "automatic_execution_allowed": { "const": false },
        "trade_ticket_generation_allowed": { "const": false },
        "human_gate_required": { "const": true }
      }
    }
  }
}
