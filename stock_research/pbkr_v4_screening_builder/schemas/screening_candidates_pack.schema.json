{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pbkr.local/v4/screening/screening_candidates_pack.schema.json",
  "title": "PBKR v4 — Screening Candidates Pack",
  "description": "Final screening candidate list. Candidate generation only. No trade signal, no PB_TRIGGER, no PB_READY, no PB_SCOUT.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "asof", "candidates", "summary", "signal_safety"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^v4\\.[0-9]+(\\.[0-9]+)?$" },
    "asof": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([+-][0-9]{2}:[0-9]{2}|Z)$" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "by_state"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "by_state": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticker", "name", "state", "pbkr_rs_rank", "filters", "labels", "risk"],
        "properties": {
          "ticker": { "type": "string", "minLength": 1, "maxLength": 32 },
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "state": {
            "enum": [
              "HARD_EXCLUDE",
              "NO_ENTRY_MARKET_STRUCTURE_ACTIVE",
              "EXTREME_RISK_FLAG_WATCH",
              "REGULAR_PB_EXCLUDE",
              "RISK_FLAG_PULLBACK_WATCH",
              "WATCH_ONLY",
              "WATCH_CANDIDATE"
            ]
          },
          "pbkr_rs_rank": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "rs_proxy": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "filters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rs_pass",
              "trading_value_pass",
              "ema_pass",
              "trend_pass",
              "structure_pass"
            ],
            "properties": {
              "rs_pass": { "type": "boolean" },
              "trading_value_pass": { "type": "boolean" },
              "ema_pass": { "type": "boolean" },
              "trend_pass": { "type": "boolean" },
              "structure_pass": { "type": "boolean" }
            }
          },
          "labels": {
            "type": "object",
            "additionalProperties": false,
            "required": ["volume_state_label", "pullback_state_label", "stop_distance_label"],
            "properties": {
              "volume_state_label": { "enum": ["dry", "normal", "expansion", "climax", "n_a"] },
              "pullback_state_label": { "enum": ["none", "shallow", "deep", "broken", "n_a"] },
              "stop_distance_label": { "enum": ["tight", "normal", "wide", "n_a"] }
            }
          },
          "risk": {
            "type": "object",
            "additionalProperties": false,
            "required": ["buckets", "raw_designations"],
            "properties": {
              "buckets": {
                "type": "array",
                "items": {
                  "enum": [
                    "HARD_EXCLUDE",
                    "REGULAR_PB_EXCLUDE",
                    "EXTREME_RISK_FLAG_WATCH",
                    "RISK_FLAG_PULLBACK_WATCH"
                  ]
                }
              },
              "raw_designations": {
                "type": "array",
                "items": { "type": "string", "maxLength": 80 }
              }
            }
          },
          "notes": { "type": "string", "maxLength": 600 }
        }
      }
    },
    "signal_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screening_only", "direct_trade_signal", "trade_signal", "automatic_execution_allowed", "human_gate_required"],
      "properties": {
        "screening_only": { "const": true },
        "direct_trade_signal": { "const": false },
        "trade_signal": { "enum": [null, false] },
        "automatic_execution_allowed": { "const": false },
        "human_gate_required": { "const": true }
      }
    }
  }
}
