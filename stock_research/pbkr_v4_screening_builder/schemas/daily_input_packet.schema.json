{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pbkr.local/v4/screening/daily_input_packet.schema.json",
  "title": "PBKR v4 — DAILY_INPUT_PACKET",
  "description": "GPT Orchestrator input. Aggregates the four upstream packs and the PBKR_RS_RANK summary. screening_only=true.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asof",
    "market_regime_placeholder",
    "tradingview_scan_pack_summary",
    "kiwoom_feature_pack_summary",
    "official_risk_flags_pack_summary",
    "screening_candidates_pack_summary",
    "pbkr_rs_rank_summary",
    "signal_safety"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^v4\\.[0-9]+(\\.[0-9]+)?$" },
    "asof": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([+-][0-9]{2}:[0-9]{2}|Z)$" },
    "market_regime_placeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regime", "note"],
      "properties": {
        "regime": { "enum": ["unknown", "stage1", "stage2", "stage3", "stage4"] },
        "note": { "type": "string", "maxLength": 240 }
      }
    },
    "tradingview_scan_pack_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_count", "rs_proxy_present_count"],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "rs_proxy_present_count": { "type": "integer", "minimum": 0 }
      }
    },
    "kiwoom_feature_pack_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_count", "median_trading_value"],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "median_trading_value": { "type": "number", "minimum": 0 }
      }
    },
    "official_risk_flags_pack_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_count", "by_bucket", "market_structure_active"],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "by_bucket": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "market_structure_active": { "type": "boolean" }
      }
    },
    "screening_candidates_pack_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "by_state", "watch_candidate_top"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "by_state": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "watch_candidate_top": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ticker", "name", "pbkr_rs_rank", "state"],
            "properties": {
              "ticker": { "type": "string", "maxLength": 32 },
              "name": { "type": "string", "maxLength": 64 },
              "pbkr_rs_rank": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
              "state": {
                "enum": [
                  "HARD_EXCLUDE",
                  "NO_ENTRY_MARKET_STRUCTURE_ACTIVE",
                  "EXTREME_RISK_FLAG_WATCH",
                  "REGULAR_PB_EXCLUDE",
                  "RISK_FLAG_PULLBACK_WATCH",
                  "WATCH_ONLY",
                  "WATCH_CANDIDATE"
                ]
              }
            }
          }
        }
      }
    },
    "pbkr_rs_rank_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["universe_size", "weights", "passed_threshold_count", "threshold"],
      "properties": {
        "universe_size": { "type": "integer", "minimum": 0 },
        "threshold": { "type": "number", "minimum": 0, "maximum": 100 },
        "passed_threshold_count": { "type": "integer", "minimum": 0 },
        "benchmark_relative_used": { "type": "boolean" },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["m1", "m3", "m6", "m12"],
          "properties": {
            "m1":  { "type": "number", "minimum": 0, "maximum": 1 },
            "m3":  { "type": "number", "minimum": 0, "maximum": 1 },
            "m6":  { "type": "number", "minimum": 0, "maximum": 1 },
            "m12": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "signal_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screening_only",
        "direct_trade_signal",
        "trade_signal",
        "automatic_execution_allowed",
        "human_gate_required",
        "operator_decision"
      ],
      "properties": {
        "screening_only": { "const": true },
        "direct_trade_signal": { "const": false },
        "trade_signal": { "enum": [null, false] },
        "automatic_execution_allowed": { "const": false },
        "human_gate_required": { "const": true },
        "operator_decision": { "enum": [null, "review", "defer"] }
      }
    }
  }
}
