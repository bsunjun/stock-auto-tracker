# local secrets / config — never commit
.env
.env.local
.env.*.local

# python
__pycache__/
*.pyc
.venv/

# OS / editor
.DS_Store
.idea/
.vscode/

# real-data sample workdirs (PR #11+). The wisereport_sample_select.py
# script and the dry-run runner produce inventories / parsed_meta / rows
# / summary files that may contain real WiseReport metadata. The intended
# location is always OUTSIDE the repo (e.g. /tmp/...). These patterns are
# a defense-in-depth backstop for the case where someone creates such a
# workdir inside the repo by mistake.
/_realdata/
**/_realdata/
/tmp_workdir/
**/tmp_workdir/
/pr11_realdata/
**/pr11_realdata/
/_pipeline_workdir/
**/_pipeline_workdir/

# PBKR v4 Screening Builder local outputs. The CLI defaults to
# /tmp/pbkr_v4_screening_out and refuses --out-dir paths inside the
# repo. This pattern is a defense-in-depth backstop for the case
# where someone creates such a directory inside the repo by mistake.
/pbkr_v4_screening_out/
**/pbkr_v4_screening_out/

# PBKR Full System v1 local outputs. Real outputs land in
# $PBKR_PROCESSED_ROOT or $PBKR_OUTPUT_ROOT (typically
# $HOME/trading/phase3/output/...). The full-system writer refuses
# out_dir paths inside the repo; these patterns are a defense-in-depth
# backstop.
/pbkr_full_system/
**/pbkr_full_system/
/pbkr_full_system_out/
**/pbkr_full_system_out/
